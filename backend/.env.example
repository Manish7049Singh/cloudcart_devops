# Database Configuration
# Leave blank to use local SQLite (ecommerce.db) automatically.
# For Neon PostgreSQL cloud database, supply the connection string with SSL:
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional individual database fields:
# DB_USERNAME=
# DB_PASSWORD=
# DB_HOSTNAME=
# DB_PORT=5432
# DB_NAME=

# JWT & Security Configuration
SECRET_KEY=local-development-only-change-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins (comma-separated, e.g. for Render frontend deployment)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
